# ============================================================
# 门店 POS（Vite + React + supabase-js）→ 静态站，nginx 服务于 :8081
# 与 miniapp(:8080) 同机共存；80 被占、8080 给 miniapp、POS 用 8081。
# Supabase anon key 面向客户端可公开，构建期注入（VITE_*）。
# ============================================================

# ---------- build stage ----------
FROM node:22-slim AS build
WORKDIR /app

# 构建期注入的前端配置（anon key 可公开；service_role/DB 密码绝不进这里）
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_ANON_KEY=""
ARG VITE_STORE_ID=""
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_STORE_ID=$VITE_STORE_ID

# vite.config 里 `@meicai/shared` 别名指向 ../../packages/shared/src，需一并拷入
COPY packages/shared ./packages/shared
COPY apps/pos ./apps/pos

WORKDIR /app/apps/pos
RUN npm install --no-audit --no-fund
RUN test -n "$VITE_SUPABASE_URL" \
      && echo "build: VITE_SUPABASE_URL present ✓" \
      || echo "build WARN: VITE_SUPABASE_URL 为空（demo 账号将无法登录）"
RUN npm run build
# 硬校验：产物里应已内联 supabase 域名（否则登录读不到后端）
RUN if grep -rlF "supabase.co" dist >/dev/null 2>&1; then \
      echo "inline-check OK: dist 已内联 supabase 域名" ; \
    else echo "BUILD WARN: dist 未见 supabase 域名（检查 VITE_SUPABASE_URL 构建参数）" ; fi

# ---------- serve stage ----------
FROM nginx:1.27-alpine
COPY deploy/nginx-pos.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/pos/dist /usr/share/nginx/html
EXPOSE 8081
CMD ["nginx", "-g", "daemon off;"]
