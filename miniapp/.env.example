# 复制为 miniapp/.env（已被 .gitignore 忽略）。
# 仅 TARO_APP_ 前缀的变量会被 Taro 注入到前端构建产物。
# anon key 面向客户端、可公开；service_role key / DB 密码 绝不放这里、绝不进前端。

TARO_APP_SUPABASE_URL=https://<your-ref>.supabase.co
TARO_APP_SUPABASE_ANON_KEY=<anon-key>

# 单店 MVP：默认指向 seed 门店（川小灶·望京店）；换门店填对应 store.id
TARO_APP_STORE_ID=11111111-1111-1111-1111-111111111111

# Edge Function 走同一 Supabase 实例的 /functions/v1/ 路径,无需额外配置
# wxpay-create / wxpay-notify / wxpay-refund / wx-login 由 SUPABASE_URL + SUPABASE_ANON_KEY 自动拼接
# 支付模式(sandbox/live)由后端 Function Secrets 控制,前端无需感知
