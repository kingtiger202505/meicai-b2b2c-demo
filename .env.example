# 复制为 .env（已被 .gitignore 忽略），填入你的 Supabase 值
# anon key 面向客户端、可公开；service_role key / 数据库密码 绝不入库、绝不进前端。

SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# 仅本地建表/seed 用（迁移脚本），不要提交、不要放进 miniapp/pos 前端：
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
